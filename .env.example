# Copy this file to .env and replace the placeholder values.
# Do not commit your real tokens, secrets, or account IDs.
#
# Note:
# - PROJECT_DB is a Wrangler D1 binding and is configured in wrangler.json / wrangler.example.jsonc,
#   not in this file.
# - PUBLIC_* values are exposed to the client. Keep secrets in non-PUBLIC variables only.

# ------------------------------------------------------------
# Public app configuration
# ------------------------------------------------------------

# Base URL of your OpenAuthster issuer.
# Example: https://auth.example.com
PUBLIC_ISSUER=<YOUR_ISSUER_URL>

# Public client ID used by the WebUI itself.
# Leave this as-is unless you know you need a different internal client.
PUBLIC_CLIENT_ID=openauth_webui

# URL of this WebUI instance.
# Use your local URL in development, or your deployed WebUI URL in production.
# Example dev: http://localhost:3001/
# Example prod: https://webui.example.com/
PUBLIC_REDIRECT_URI=http://localhost:3001/

# Runtime mode.
# Use development for local work, production for deployed environments.
NODE_ENV=development

# ------------------------------------------------------------
# Server-side WebUI secret
# ------------------------------------------------------------

# Secret used by the WebUI server to sign and authorize internal operations.
# Generate a long random value and keep it private.
# Example: a UUID or any high-entropy random string.
WEBUI_SECRET=<GENERATE_A_RANDOM_SECRET>

# ------------------------------------------------------------
# Cloudflare account and D1 access
# ------------------------------------------------------------

# Your Cloudflare account ID.
CF_ACCOUNT_ID=<YOUR_CLOUDFLARE_ACCOUNT_ID>

# Cloudflare API token used by Wrangler / D1-related tooling.
CLOUDFLARE_TOKEN=<YOUR_CLOUDFLARE_TOKEN>

# D1 database ID used by local tooling such as Drizzle and Wrangler.
CLOUDFLARE_D1_ID=<YOUR_D1_DATABASE_ID>

# Cloudflare API token used by the WebUI to manage issuer custom domains.
# This should have the permissions required for Workers/domain management.
CLOUDFLARE_API_TOKEN=<YOUR_CLOUDFLARE_API_TOKEN>

# ------------------------------------------------------------
# Cloudflare issuer domain management
# ------------------------------------------------------------

# Zone ID for the domain that will host project auth endpoints.
CLOUDFLARE_AUTH_DOMAIN_ZONE_ID=<YOUR_CLOUDFLARE_ZONE_ID>

# Name of the deployed Cloudflare Worker service for your issuer.
# Example: openauthster-issuer
CLOUDFLARE_WORKER_SERVICE_NAME=<YOUR_WORKER_SERVICE_NAME>

# Base custom domain used to create per-project auth endpoints.
# Must start with http:// or https:// and must not end with a trailing slash.
# Example: https://auth.example.com
CLOUDFLARE_AUTH_ENDPOINT_DOMAIN=https://auth.example.com

# ------------------------------------------------------------
# Deployment mode
# ------------------------------------------------------------

# Set to true only when running the self-hosted mode expected by this instance.
# Most Cloudflare-hosted setups should keep this as true in .env.
SELF_HOSTED=true