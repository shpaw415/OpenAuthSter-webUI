		"@types/js-cookie": "^3.0.6",
		"cloudflare": "^5.2.0",
		"drizzle-orm": "^0.45.1",
		"frame-master": "^3.1.1",
		"frame-master-plugin-apply-react": "0.2.6",
		"frame-master-plugin-cloudflare-pages-functions-action": "https://github.com/shpaw415/frame-master-plugin-cloudflare-pages-functions-action.git#0.3.0",
		"frame-master-plugin-env-in-html": "^0.1.1",
		"frame-master-plugin-image-optimizer": "^0.1.0",
