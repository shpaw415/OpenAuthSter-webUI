		"tailwindcss": "^4.2.1",
		"valibot": "^1.2.0"
	},
	"scripts": {
		"dev": "NODE_ENV=development bun frame-master start",
		"build": "NODE_ENV=production bun frame-master build",
		"build:dev": "NODE_ENV=development bun frame-master build",
		"init:db": "wrangler d1 migrations apply PROJECT_DB",
		"db:generate": "bun --bun drizzle-kit generate",
		"db:migrate": "bun --bun drizzle-kit migrate",
		"update:share": "bun update openauth-webui-shared-types",
		"dev:deploy": "NODE_ENV=production bun frame-master build && wrangler pages deploy"
	}
