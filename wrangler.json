{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "openauthster-personal-webui",
	"pages_build_output_dir": ".frame-master/build",
	"compatibility_date": "2025-11-09",
	"d1_databases": [],
	"vars": {
		"BUN_VERSION": "1.3.10",
		"SKIP_DEPENDENCY_INSTALL": "true",
		"PUBLIC_CLIENT_ID": "openauth_webui",
		"SELF_HOSTED": "true",

		"PUBLIC_REDIRECT_URI": "https://auth.m2-tech.ca/dashboard",
		"PUBLIC_ISSUER": "https://auth-issuer.m2-tech.ca",
		"CF_ACCOUNT_ID": "c4dac0bc0538db5e8d63fe89fd112238",
		"CLOUDFLARE_AUTH_DOMAIN_ZONE_ID": "dfaa41c9905972df8f14fc898042a0f1",
		"CLOUDFLARE_WORKER_SERVICE_NAME": "m2-tech-openauthster-issuer",
		"CLOUDFLARE_AUTH_ENDPOINT_DOMAIN": "https://auth-issuer.m2-tech.ca"
	},
	"secrets": {
		"required": ["CLOUDFLARE_API_TOKEN", "WEBUI_SECRET"]
	},
	"compatibility_flags": ["nodejs_compat"]
}
