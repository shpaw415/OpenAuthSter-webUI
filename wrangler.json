{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "openauthster-personal-webui",
	"pages_build_output_dir": ".frame-master/build",
	"compatibility_date": "2025-11-09",
	"d1_databases": [
		{
			"binding": "PROJECT_DB",
			"database_id": "fb25c3b0-0b33-49f9-b959-6ec8d7a74b8c"
		}
	],
	"vars": {
		"PUBLIC_REDIRECT_URI": "https://admin.webcreas.com/",
		"PUBLIC_ISSUER": "https://auth.webcreas.com",
		"CF_ACCOUNT_ID": "17b0a92da13df078f38bcd297ee71f81",
		"CLOUDFLARE_AUTH_DOMAIN_ZONE_ID": "d426dfbc9139424022156d27d5ea6b31",
		"CLOUDFLARE_WORKER_SERVICE_NAME": "openauthster-webcreation",
		"CLOUDFLARE_AUTH_ENDPOINT_DOMAIN": "https://auth.webcreas.com",

		"BUN_VERSION": "1.3.10",
		"SKIP_DEPENDENCY_INSTALL": "true",
		"PUBLIC_CLIENT_ID": "openauth_webui",
		"SELF_HOSTED": "true"
	},
	"secrets": {
		"required": ["CLOUDFLARE_API_TOKEN", "WEBUI_SECRET"]
	},
	"compatibility_flags": ["nodejs_compat"]
}
