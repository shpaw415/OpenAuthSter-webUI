{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "openauthster-webui",
  "pages_build_output_dir": ".frame-master/build",
  "compatibility_date": "2025-11-09",
  "d1_databases": [
    {
      "binding": "PROJECT_DB",
      "database_name": "openauth-db",
      "database_id": "0ac321d7-1d05-49f8-b900-5e29cfae6c8c",
      "migrations_dir": "drizzle/migrations",
      "remote": true
    }
  ],
  "vars": {
    "BUN_VERSION": "1.3.4",
    "SKIP_DEPENDENCY_INSTALL": "true",
    "PUBLIC_CLIENT_ID": "openauth_webui",
    "PUBLIC_REDIRECT_URI": "http://localhost:3001/auth/callback",
    "PUBLIC_ISSUER": "http://localhost:8788"
  },
  "compatibility_flags": ["nodejs_compat"]
}
